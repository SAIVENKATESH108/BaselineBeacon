# BaselineBeacon — environment template
# Copy to `.env` and fill in. NEVER commit `.env`.
#
# NOTE: variables prefixed VITE_ are embedded in the client bundle and are
# PUBLIC to anyone using the app. Never put secrets or service-role keys here.

# --- Supabase (auth + storage) ---
# Project URL: Supabase dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
# Anonymous/public anon key (safe for client use; still never commit real values)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- Google Gemini (AI text extraction) ---
# Used by src/lib/gemini.ts. If unset/invalid, the app falls back to a local mock
# and manual entry remains available.
# Verify key creation and client-side key restrictions against official Google docs.
VITE_GEMINI_API_KEY=your-gemini-api-key-here

# --- Voice transcription (TBD) ---
# Not yet decided; see docs/PRODUCT_SPEC.md open question 9.1.
# VITE_TRANSCRIPTION_PROVIDER=webspeech|gemini|other
